# Required for local development session signing
JWT_SECRET=replace-with-a-long-random-secret
DEV_AUTH_ENABLED=true
DEV_AUTH_OPEN_ID=dev_local_admin

# Required for persisted students, passages, sessions, and metrics.
# The current Drizzle schema uses the configured MySQL-compatible driver.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/braillehelp

# Option A: run the included local Braille AI service and point to it.
LOCAL_AI_URL=http://127.0.0.1:8000

# Option B: use the managed Forge storage/LLM/transcription services.
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# OAUTH_SERVER_URL=
# VITE_APP_ID=
# VITE_OAUTH_PORTAL_URL=
# OWNER_OPEN_ID=
